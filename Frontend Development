}

aside {
    width: 260px;
    background: white;
    padding: 20px;
    border-radius: 8px;
}

main {
    flex: 1;
    background: white;
    padding: 20px;
    border-radius: 8px;
}

input {
    width: 100%;
    padding: 12px;
    margin-bottom: 15px;
    font-size: 18px;
}

textarea {
    width: 100%;
    height: 400px;
    padding: 15px;
    font-size: 16px;
    resize: vertical;
}

button {
    padding: 10px 15px;
    margin: 5px;
    border: none;
    border-radius: 5px;
    background: #2878d0;
    color: white;
    cursor: pointer;
}

button:hover {
    background: #185da8;
}

.toolbar {
    margin-bottom: 15px;
}

.note-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 10px 0;
    border-bottom: 1px solid #ddd;
    gap: 5px;
}

.note-item span {
    cursor: pointer;
    overflow-wrap: anywhere;
}

.delete {
    background: #dc3545;
}

.preview {
    min-height: 400px;
    padding: 15px;
    border: 1px solid #ddd;
    overflow-wrap: anywhere;
